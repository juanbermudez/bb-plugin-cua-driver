    "branding": {
      "icon": "./icons/cua.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.16",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "^0.39.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.10.0",
    "jsdom": "^29.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "description": "Computer use for bb agents, powered by Cua Driver: background desktop and browser control on the thread's machine, with per-provider routing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanbermudez/bb-plugin-cua-driver.git"
  },
  "homepage": "https://github.com/juanbermudez/bb-plugin-cua-driver#readme",
  "keywords": [
    "bb-plugin",
    "computer-use",
    "cua",
    "desktop-automation",
    "mcp"
  ],
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "sync:schemas": "node scripts/sync-upstream-schemas.mjs",
    "test:live": "CUA_LIVE=1 vitest run live.test.ts"
  }
